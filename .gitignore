# --- data (never commit the dataset) ---
data/raw/*
data/processed/*
data/manifests/*
!data/**/.gitkeep
# but DO commit the tiny SCP label dictionary (12 KB, openly licensed): the whole
# pipeline reads it for the 71-code label space + descriptions, so bundling it makes
# the repo (and the HF Space) runnable without the multi-GB waveform download.
# (Un-ignore the dir, re-ignore its contents, then un-ignore just the one CSV.)
!data/raw/ptbxl/
data/raw/ptbxl/*
!data/raw/ptbxl/scp_statements.csv

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version

# --- ml artifacts ---
wandb/
*.ckpt
*.pt
*.pth
checkpoints/
outputs/
lightning_logs/

# --- notebooks ---
.ipynb_checkpoints/

# --- secrets / env ---
.env
*.key

# --- os / editor ---
.DS_Store
.idea/
.vscode/
