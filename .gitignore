# --- data (never commit the dataset) ---
data/raw/*
data/processed/*
data/manifests/*
!data/**/.gitkeep
# but DO commit the tiny SCP label dictionary (12 KB, openly licensed): the whole
# pipeline reads it for the 71-code label space + descriptions, so bundling it makes
# the repo (and the HF Space) runnable without the multi-GB waveform download.
# (Un-ignore the dir, re-ignore its contents, then un-ignore just the one CSV.)
!data/raw/ptbxl/
data/raw/ptbxl/*
!data/raw/ptbxl/scp_statements.csv

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version

# --- ml artifacts ---
wandb/
*.ckpt
*.pt
*.pth
checkpoints/
outputs/
lightning_logs/
# ...except the Phase-19 distilled student (1.0 MB). It is the whole point of that
# phase: 35x smaller than the teacher and within 0.3% of its AUROC, so committing it
# makes `analyze_signal(..., checkpoint=...)` runnable straight from a clone — no 20 GB
# waveform download and no retraining. Same reasoning as the bundled scp_statements.csv.
!outputs/
outputs/*
!outputs/student_w16b1_kd_best.pt

# --- notebooks ---
.ipynb_checkpoints/

# --- secrets / env ---
.env
*.key

# --- os / editor ---
.DS_Store
.idea/
.vscode/

# --- RAG (Phase 21) ---
# The corpus IS committed: it is fetched from a live source, so it is the artifact of
# record for the reported results. The indexes are derived from it deterministically
# (`make rag-index` / `--no-fetch`, no network needed) and are large — and the TF-IDF one
# is a pickle, which is not something to ship in a public repo.
data/reference/dense_index.npz
data/reference/tfidf_index.pkl

# --- Phase 28 benchmark ---
# Per-record outputs for the APEX arms are ~3 MB each and regenerate in ~12 s
# (`make benchmark-foundation`). The local-LLM arm's outputs ARE committed: they take 18
# minutes of inference to reproduce and are the evidence behind the self-contradiction
# denominator and the quoted example replies.
docs/benchmark/raw/apex.json
docs/benchmark/raw/apex-student.json
